  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Zhao-T-X/CGM.git" },
  "homepage": "https://github.com/Zhao-T-X/CGM#readme",
  "bugs": { "url": "https://github.com/Zhao-T-X/CGM/issues" },
  "files": [
    "cli.mjs",
    "server.mjs",
    "mcp.mjs",
    "verify-mcp.mjs",
    "public/index.html",
    "public/img",
    "mcp-config.json",
    "install.sh",
    "install.cmd",
    "install.ps1",
    "README.en.md",
    "DEPLOY-Linux.md",
    "LICENSE"
